{
  "name": "guess-the-line",
  "version": "0.1.0",
  "private": true,
  "description": "Guess the Line app, dashboard and Guess the Spread / Guess the Total scoring engine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs && vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "build:cloud": "vite build --mode cloud --outDir ../.local/cloud-dist",
    "preview:cloud": "vite preview --mode cloud --outDir ../.local/cloud-dist --host 127.0.0.1 --port 4173",
    "cloudflare": "node scripts/cloudflare.mjs",
    "check:cloud": "node scripts/check-cloud-boundary.mjs",
    "test:cloud-browser": "playwright test --config playwright.cloud.config.js",
    "test:engine": "vitest run",
    "typecheck": "tsc --noEmit",
    "score": "tsx src/cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^5.0.0",
    "supabase": "2.120.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
