{
  "name": "Guess The Line",
  "system": "D-38 redesign: Arena with three grafts",
  "version": "2.0.0",
  "status": "Approved with the D-38 prototype (canvas version 2), October 14, 2026; D-55 glow, glass, chart and soft-card tokens approved October 21, 2026 (round 3 boards). Used only by the new app in web/src/next. design/tokens.json stays for the old app.",
  "css": {
    "root": ".gx",
    "classPrefix": "gx-",
    "propertyPrefix": "--gx-",
    "files": [
      "web/src/next/styles/tokens.css",
      "web/src/next/styles/base.css",
      "web/src/next/styles/components.css"
    ],
    "themeAttribute": "data-theme",
    "motionAttribute": "data-motion"
  },
  "webfonts": {
    "stylesheet": "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Big+Shoulders+Display:wght@700;800&family=Figtree:wght@400;500;600;700;800&display=swap",
    "preconnect": "https://fonts.gstatic.com",
    "weights": {
      "Barlow Condensed": [500, 600, 700],
      "Big Shoulders Display": [700, 800],
      "Figtree": [400, 500, 600, 700, 800]
    }
  },
  "font": {
    "display": "\"Big Shoulders Display\", Impact, \"Arial Narrow\", sans-serif",
    "num": "\"Barlow Condensed\", \"Arial Narrow\", sans-serif",
    "body": "Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px",
    "9": "48px",
    "10": "64px"
  },
  "radius": {
    "xs": "6px",
    "sm": "10px",
    "md": "16px",
    "lg": "24px",
    "pill": "999px"
  },
  "dur": {
    "tap": "100ms",
    "quick": "160ms",
    "base": "240ms",
    "exit": "200ms",
    "big": "600ms",
    "pulse": "1800ms"
  },
  "ease": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
    "pop": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "z": {
    "content": "1",
    "topbar": "20",
    "tabbar": "30",
    "dock": "35",
    "sheet": "40",
    "dialog": "45",
    "popover": "48",
    "toast": "50",
    "overlay": "60"
  },
  "size": {
    "touch": "44px",
    "primary": "52px",
    "topbar": "56px",
    "tabbar": "64px",
    "dock": "56px",
    "gutter": "16px",
    "content": "520px"
  },
  "av": {
    "ink": "#0B1020",
    "iris": "#B7ADFF",
    "peach": "#FFB79E",
    "sky": "#8FD8FF",
    "mint": "#8FE6C0",
    "butter": "#FFD97A",
    "rose": "#FFA3BE",
    "lilac": "#DDB3FF",
    "sand": "#DCCDAE"
