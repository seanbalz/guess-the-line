  "type": {
    "display": { "family": "display", "weight": 800, "size": "40px", "lineHeight": "40px", "transform": "uppercase", "tracking": "0.01em", "use": "Home hero line, celebration title. One per screen at most." },
    "title": { "family": "display", "weight": 800, "size": "28px", "lineHeight": "32px", "transform": "uppercase", "tracking": "0.01em", "use": "The one screen title." },
    "section": { "family": "display", "weight": 700, "size": "20px", "lineHeight": "24px", "transform": "uppercase", "tracking": "0.04em", "use": "Section heads, sheet and dialog titles." },
    "team": { "family": "num", "weight": 700, "size": "20px", "lineHeight": "24px", "transform": "uppercase", "tracking": "0.02em", "tabular": true, "use": "Team abbreviations." },
    "body": { "family": "body", "weight": 500, "size": "16px", "lineHeight": "24px", "use": "Reading text and inputs (16px stops iPhone zoom)." },
    "strong": { "family": "body", "weight": 700, "size": "16px", "lineHeight": "24px", "use": "Names, button labels." },
    "label": { "family": "body", "weight": 600, "size": "14px", "lineHeight": "20px", "tracking": "0.01em", "use": "Chip captions, small labels. Not for tappable text." },
    "meta": { "family": "body", "weight": 500, "size": "13px", "lineHeight": "18px", "tracking": "0.01em", "use": "Kickoff, source and age." },
    "micro": { "family": "body", "weight": 700, "size": "12px", "lineHeight": "16px", "transform": "uppercase", "tracking": "0.06em", "use": "Status pills and counters only. The floor." },
    "n-xl": { "family": "num", "weight": 700, "size": "56px", "lineHeight": "56px", "tabular": true, "use": "Home countdown only." },
    "n-l": { "family": "num", "weight": 700, "size": "32px", "lineHeight": "32px", "tabular": true, "use": "Final scores, your guess readout." },
    "n-m": { "family": "num", "weight": 600, "size": "24px", "lineHeight": "28px", "tracking": "0.01em", "tabular": true, "use": "Lines on cards, board values." },
    "n-s": { "family": "num", "weight": 600, "size": "18px", "lineHeight": "22px", "tracking": "0.01em", "tabular": true, "use": "Odds lines, chip numbers, small stats." },
    "n-xs": { "family": "num", "weight": 600, "size": "16px", "lineHeight": "20px", "tracking": "0.01em", "tabular": true, "use": "Odds prices, to-win amounts." }
  },
