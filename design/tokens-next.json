        "accent-ink": "#2B3BFF",
        "accent-tint": "#E8EBFF",
        "data": "#03658A",
        "data-tint": "#DBF3FE",
        "win": "#067247",
        "win-tint": "#DAF7ED",
        "loss": "#B32643",
        "loss-tint": "#FEE7EB",
        "pending": "#8C5200",
        "pending-tint": "#FEF3D8",
        "live": "#7B2CBF",
        "live-tint": "#F5E8FF",
        "on-state": "#FFFFFF",
        "focus": "#2B3BFF",
        "overlay": "#0B0D17CC",
        "toast-bg": "#FFFFFF",
        "seg-on": "#FFFFFF",
        "glass": "#FFFFFF",
        "glass-line": "#E3E8F0",
        "track": "#E3E8F0",
        "hero-base": "#FFFFFF",
        "hero-text-2": "#50566F",
        "chart-line": "#2B3BFF",
        "glow-1": "#7DD3FC",
        "glow-2": "#6EE7B7",
        "glow-3": "#2B3BFF",
        "bar-1": "#2B3BFF",
        "bar-2": "#059669",
        "home-fill": "#2B3BFF",
        "home-ink": "#FFFFFF",
        "home-button-fill": "#FFFFFF",
        "home-button-ink": "#2B3BFF",
        "home-track": "#FFFFFF33",
        "home-glass": "#FFFFFF1A",
        "brand-warm": "#FFE3D6",
        "brand-ember": "#FF5A1F"
      },
      "effect": {
        "e1": "0 1px 0 #FFFFFF, 0 8px 24px rgba(11, 13, 23, 0.08)",
        "e2": "0 8px 24px rgba(11, 16, 32, 0.12)",
        "e3": "0 -12px 40px rgba(11, 16, 32, 0.16)",
        "glow-accent": "0 0 0 1px #2B3BFF",
        "glow-live": "0 0 0 2px #7B2CBF",
        "glow-win": "0 0 0 2px #067247",
        "lime-edge": "0 0 0 0 transparent",
        "av-ring": "0 0 0 1px #D3DAE5",
        "float-ring": "0 0 0 1px #6E7D96",
        "hero-shadow": "var(--gx-e2)",
        "wash": "none",
        "yardlines": "none",
        "hero-card": "#FFFFFF",
        "hero-ring": "var(--gx-e1)",
        "glass-shadow": "var(--gx-e1)",
        "glass-blur": "none",
        "chart-glow": "0"
      }
    }
  }
}
