{
  "name": "Guess The Line",
  "system": "Signal Focus: D-38 application with preserved semantic states",
  "version": "2.1.0",
  "status": "Signal Focus selected by Ben from Home light and Research dark comparisons, November 5, 2026. Local implementation branch; no merge or production release.",
  "css": {
    "root": ".gx",
    "classPrefix": "gx-",
    "propertyPrefix": "--gx-",
    "files": [
      "web/src/next/styles/tokens.css",
      "web/src/next/styles/base.css",
      "web/src/next/styles/components.css"
    ],
    "themeAttribute": "data-theme",
    "motionAttribute": "data-motion"
  },
  "webfonts": {
    "stylesheet": "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Big+Shoulders+Display:wght@700;800&family=Figtree:wght@400;500;600;700;800&display=swap",
    "preconnect": "https://fonts.gstatic.com",
    "weights": {
      "Barlow Condensed": [
        500,
        600,
        700
      ],
      "Big Shoulders Display": [
        700,
        800
      ],
      "Figtree": [
        400,
        500,
        600,
        700,
        800
      ]
    }
  },
  "font": {
    "display": "Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "num": "\"Barlow Condensed\", \"Arial Narrow\", sans-serif",
    "body": "Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px",
    "9": "48px",
    "10": "64px"
  },
  "radius": {
    "xs": "6px",
    "sm": "10px",
    "md": "26px",
    "lg": "28px",
    "pill": "999px"
  },
  "dur": {
    "tap": "100ms",
    "quick": "160ms",
    "base": "240ms",
    "exit": "200ms",
    "big": "600ms",
    "pulse": "1800ms"
  },
  "ease": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
    "pop": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "z": {
    "content": "1",
    "topbar": "20",
    "tabbar": "30",
    "dock": "35",
    "sheet": "40",
    "dialog": "45",
    "popover": "48",
    "toast": "50",
    "overlay": "60"
  },
  "size": {
    "touch": "44px",
    "primary": "52px",
    "topbar": "56px",
    "tabbar": "64px",
    "dock": "56px",
    "gutter": "16px",
    "content": "520px"
  },
  "av": {
    "ink": "#0B1020",
    "iris": "#B7ADFF",
    "peach": "#FFB79E",
    "sky": "#8FD8FF",
    "mint": "#8FE6C0",
    "butter": "#FFD97A",
    "rose": "#FFA3BE",
    "lilac": "#DDB3FF",
    "sand": "#DCCDAE"
  },
  "type": {
    "display": {
      "family": "display",
      "weight": 800,
      "size": "40px",
      "lineHeight": "40px",
      "transform": "none",
      "tracking": "-0.02em",
      "use": "Home hero line, celebration title. One per screen at most."
    },
    "title": {
      "family": "display",
      "weight": 800,
      "size": "28px",
      "lineHeight": "32px",
      "transform": "none",
      "tracking": "-0.02em",
      "use": "The one screen title."
    },
    "section": {
      "family": "display",
      "weight": 700,
      "size": "20px",
      "lineHeight": "24px",
      "transform": "none",
      "tracking": "-0.02em",
      "use": "Section heads, sheet and dialog titles."
    },
    "team": {
      "family": "num",
      "weight": 700,
      "size": "20px",
      "lineHeight": "24px",
      "transform": "uppercase",
      "tracking": "0.02em",
      "tabular": true,
      "use": "Team abbreviations."
    },
    "body": {
      "family": "body",
      "weight": 500,
      "size": "16px",
      "lineHeight": "24px",
      "use": "Reading text and inputs (16px stops iPhone zoom)."
    },
    "strong": {
      "family": "body",
      "weight": 700,
      "size": "16px",
      "lineHeight": "24px",
      "use": "Names, button labels."
    },
    "label": {
      "family": "body",
      "weight": 600,
      "size": "14px",
      "lineHeight": "20px",
      "tracking": "0.01em",
      "use": "Chip captions, small labels. Not for tappable text."
    },
    "meta": {
      "family": "body",
      "weight": 500,
      "size": "13px",
      "lineHeight": "18px",
      "tracking": "0.01em",
      "use": "Kickoff, source and age."
    },
    "micro": {
      "family": "body",
      "weight": 700,
      "size": "12px",
      "lineHeight": "16px",
      "transform": "uppercase",
      "tracking": "0.06em",
      "use": "Status pills and counters only. The floor."
    },
    "n-xl": {
      "family": "num",
      "weight": 700,
      "size": "56px",
      "lineHeight": "56px",
      "tabular": true,
      "use": "Home countdown only."
    },
    "n-l": {
      "family": "num",
      "weight": 700,
      "size": "32px",
      "lineHeight": "32px",
      "tabular": true,
      "use": "Final scores, your guess readout."
    },
    "n-m": {
      "family": "num",
      "weight": 600,
      "size": "24px",
      "lineHeight": "28px",
      "tracking": "0.01em",
      "tabular": true,
      "use": "Lines on cards, board values."
    },
    "n-s": {
      "family": "num",
      "weight": 600,
      "size": "18px",
      "lineHeight": "22px",
      "tracking": "0.01em",
      "tabular": true,
      "use": "Odds lines, chip numbers, small stats."
    },
    "n-xs": {
      "family": "num",
      "weight": 600,
      "size": "16px",
      "lineHeight": "20px",
      "tracking": "0.01em",
      "tabular": true,
      "use": "Odds prices, to-win amounts."
    }
  },
  "themeColor": {
    "dark": "#0B0D17",
    "light": "#E8EBFF"
  },
  "themes": {
    "dark": {
      "colorScheme": "dark",
      "color": {
        "canvas": "#0B0D17",
        "surface-1": "#171B30",
        "surface-2": "#1B2038",
        "surface-3": "#222844",
        "border": "#515A87",
        "border-strong": "#7A89A6",
        "text-1": "#FFFFFF",
        "text-2": "#BEC3DE",
        "text-3": "#ADB5D1",
        "accent": "#2B3BFF",
        "accent-text": "#FFFFFF",
        "accent-ink": "#A8AFFF",
        "accent-tint": "#222844",
        "data": "#38BDF8",
        "data-tint": "#17344D",
        "win": "#34D399",
        "win-tint": "#17383E",
        "loss": "#FC7C8E",
        "loss-tint": "#372A3D",
        "pending": "#FBBF24",
        "pending-tint": "#32312C",
        "live": "#D08CFF",
        "live-tint": "#332F53",
        "on-state": "#070B16",
        "focus": "#A8AFFF",
        "overlay": "#0B0D17CC",
        "toast-bg": "#171B30",
        "seg-on": "#222844",
        "glass": "#FFFFFF1A",
        "glass-line": "#FFFFFF33",
        "track": "#FFFFFF29",
        "hero-base": "#171B30",
        "hero-text-2": "#BEC3DE",
        "chart-line": "#A8AFFF",
        "glow-1": "#7DD3FC",
        "glow-2": "#34D399",
        "glow-3": "#A8AFFF",
        "bar-1": "#A8AFFF",
        "bar-2": "#34D399",
        "home-fill": "#2B3BFF",
        "home-ink": "#FFFFFF",
        "home-button-fill": "#FFFFFF",
        "home-button-ink": "#2B3BFF",
        "home-track": "#FFFFFF33",
        "home-glass": "#FFFFFF1A",
        "brand-warm": "#FFE3D6",
        "brand-ember": "#FF5A1F"
      },
      "effect": {
        "e1": "0 1px 0 rgba(255, 255, 255, 0.12), 0 8px 24px rgba(11, 13, 23, 0.12)",
        "e2": "0 8px 24px rgba(0, 0, 0, 0.45)",
        "e3": "0 -16px 48px rgba(0, 0, 0, 0.6)",
        "glow-accent": "0 0 0 1px #A8AFFF",
        "glow-live": "0 0 0 1px rgba(208, 140, 255, 0.65), 0 0 18px rgba(208, 140, 255, 0.35)",
        "glow-win": "0 0 0 1px rgba(52, 211, 153, 0.6), 0 0 24px rgba(52, 211, 153, 0.35)",
        "lime-edge": "inset 0 0 0 1px #A8AFFF",
        "av-ring": "0 0 0 0 transparent",
        "float-ring": "0 0 0 0 transparent",
        "hero-shadow": "var(--gx-e1)",
        "wash": "none",
        "yardlines": "none",
        "hero-card": "#171B30",
        "hero-ring": "var(--gx-e1)",
        "glass-shadow": "var(--gx-e1)",
        "glass-blur": "none",
        "chart-glow": "0.6"
      }
    },
    "light": {
      "colorScheme": "light",
      "color": {
        "canvas": "#E8EBFF",
        "surface-1": "#FFFFFF",
        "surface-2": "#F3F4FF",
        "surface-3": "#E8EBFF",
        "border": "#BCC2E2",
        "border-strong": "#6E7D96",
        "text-1": "#0B0D17",
